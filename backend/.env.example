# =========================================================
# .env.example — Modèle de configuration
# =========================================================
# Ce fichier est versionné dans Git.
# Il documente les variables attendues.
# Ne JAMAIS y mettre de valeur réelle sensible.
# =========================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=configuration.settings.dev
DJANGO_SECRET_KEY=change-me-generate-a-new-one
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données (PostgreSQL) ---
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Internationalisation ---
DJANGO_LANGUAGE_CODE=fr-fr
DJANGO_TIME_ZONE=UTC