# =========================================================
# .gitignore — Portfolio Jeremie Katolo
# =========================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Environnements virtuels ---
.venv/
venv/
env/
ENV/

# --- Django ---
*.log
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
local_settings.py

# --- Variables d'environnement / secrets ---
.env
.env.*
!.env.example

# --- Node / React (préparation, pas encore utilisé) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
.cache/

# --- IDE / Éditeurs ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Divers ---
*.bak
*.tmp
*.orig